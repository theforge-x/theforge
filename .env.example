# Application and database
DATABASE_URL=postgresql://theforge:theforge@localhost:6543/theforge
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Zoom Server-to-Server OAuth (required to approve appointments and create links)
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# Stripe Checkout and webhook signing
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Paystack transaction API and webhook signing
PAYSTACK_SECRET_KEY=sk_test_replace_me

# One-time bootstrap credentials used by `npm run db:bootstrap`.
# Change these values before running the command and remove them afterward.
BOOTSTRAP_ADMIN_NAME=The Forge Admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-with-a-strong-password
BOOTSTRAP_CLIENT_NAME=Priya Nandakumar
BOOTSTRAP_CLIENT_EMAIL=client@example.com
BOOTSTRAP_CLIENT_PASSWORD=change-me-with-a-strong-password
